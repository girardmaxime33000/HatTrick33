# Clé secrète Stripe (paiement). Sans elle, le panier affiche "paiement non activé".
STRIPE_SECRET_KEY=
# URL publique du site (retours Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Adresse qui reçoit les demandes des clubs
NEXT_PUBLIC_CONTACT_EMAIL=
# Lien du compte Instagram (affiché en pied de page s'il est renseigné)
NEXT_PUBLIC_INSTAGRAM_URL=
# Webhook du service d'e-mailing : la section d'inscription s'affiche uniquement s'il est renseigné
NEWSLETTER_WEBHOOK_URL=
